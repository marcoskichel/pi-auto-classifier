{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"files": {
		"includes": [
			"**",
			"!package.json",
			"!release-please-config.json",
			"!.release-please-manifest.json"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": {
						"maxLines": 25,
						"skipBlankLines": true
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/test.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"complexity": {
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [[":NODE:", ":PACKAGE:"], ":BLANK_LINE:", ":PATH:"]
					}
				}
			}
		}
	}
}
